#!/usr/bin/env python3
"""Use the pinned runtime and disposable local data in an agent checkout."""

import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / ".cache" / "agent-data"


def main():
    command, *args = sys.argv[1:]
    env = dict(os.environ, ALJAM3_DATA_DIR=str(DATA))
    os.chdir(ROOT)
    if command == "setup":
        DATA.mkdir(parents=True, exist_ok=True)
        subprocess.run(["mise", "exec", "--", "ruby", "bin/setup"], env=env, check=True)
    elif command == "run":
        if not args:
            raise ValueError("Supply a command")
        DATA.mkdir(parents=True, exist_ok=True)
        os.execvpe("mise", ["mise", "exec", "--", *args], env)
    elif command != "status":
        raise ValueError("Use setup, run or status")
    print(json.dumps({"data": str(DATA), "evidence": str(ROOT / ".cache/agent-evidence"),
                      "note": "No daemon started. Keep evidence until it is uploaded; delete only this worktree's scratch data after review."}, indent=2))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, subprocess.CalledProcessError) as error:
        sys.exit(f"Workspace error: {error}")
