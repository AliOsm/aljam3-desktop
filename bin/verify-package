#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../packaging/verify_runtime"

root = File.expand_path("..", __dir__)
windows = Gem.win_platform?
pdf_only = ARGV.delete("--pdf-only")
abort "Usage: bin/verify-package [--pdf-only]" unless ARGV.empty?
# Exercise non-ASCII paths as well as spaces, including the user's data directory.
verification = File.join(root, ".cache", "Packaged App Test - مكتبة الجامع")
FileUtils.rm_rf(verification)
FileUtils.mkdir_p(verification)
source = File.join(root, "dist", windows ? "Aljam3" : "Aljam3.app")
bundle = File.join(verification, File.basename(source))
if windows
  FileUtils.cp_r(source, bundle)
else
  system("ditto", source, bundle) || abort("Unable to copy app for verification")
end
scratch = File.join(verification, "home")
output = File.join(root, "dist/verification")
FileUtils.mkdir_p([scratch, output])
FileUtils.cp_r(File.join(root, ".cache/smoke"), File.join(scratch, "data")) unless pdf_only
PackageVerification.call(bundle:, home: File.join(scratch, "pdf"), output: File.join(output, "pdf"),
  probe: File.join(root, "packaging/pdf_probe.rb"))
exit if pdf_only
PackageVerification.call(bundle:, home: scratch, output:)
PackageVerification.call(bundle:, home: File.join(scratch, "interactions"), output: File.join(output, "interactions"),
  probe: File.join(root, "packaging/interaction_probe.rb"))
%w[settings settings_startup analytics].each do |name|
  PackageVerification.call(bundle:, home: File.join(scratch, name), output: File.join(output, name),
    probe: File.join(root, "test/support/#{name}_probe.rb"))
end
PackageVerification.call(bundle:, home: scratch, output: File.join(output, "motion"),
  probe: File.join(root, "packaging/motion_probe.rb"))
require_relative "../packaging/motion_report"
MotionReport.call(File.join(output, "motion"))
if windows
  require_relative "../packaging/verify_windows_launcher"
  WindowsLauncherVerification.call(bundle:, home: scratch, output:)
  PackageVerification.call(bundle:, home: File.join(scratch, "first-launch"), output: File.join(output, "window-icons"),
    probe: File.join(root, "packaging/window_icon_probe.rb"))
end
