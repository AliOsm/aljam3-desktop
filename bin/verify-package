#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../packaging/verify_runtime"

root = File.expand_path("..", __dir__)
windows = Gem.win_platform?
# Exercise non-ASCII paths as well as spaces, including the user's data directory.
verification = File.join(root, ".cache", "Packaged App Test - مكتبة الجامع")
FileUtils.rm_rf(verification)
FileUtils.mkdir_p(verification)
source = File.join(root, "dist", windows ? "Aljam3" : "Aljam3.app")
bundle = File.join(verification, File.basename(source))
if windows
  FileUtils.cp_r(source, bundle)
else
  system("ditto", source, bundle) || abort("Unable to copy app for verification")
end
scratch = File.join(verification, "home")
output = File.join(root, "dist/verification")
FileUtils.mkdir_p([scratch, output])
FileUtils.cp_r(File.join(root, ".cache/smoke"), File.join(scratch, "data"))
PackageVerification.call(bundle:, home: scratch, output:)
if windows
  require_relative "../packaging/verify_windows_launcher"
  WindowsLauncherVerification.call(bundle:, home: scratch, output:)
  PackageVerification.call(bundle:, home: File.join(scratch, "first-launch"), output: File.join(output, "window-icons"),
    probe: File.join(root, "packaging/window_icon_probe.rb"))
end
