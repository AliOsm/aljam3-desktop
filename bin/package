#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "fileutils"
require "rbconfig"
require "digest"
require "json"

ROOT = File.expand_path("..", __dir__)
WINDOWS = Gem.win_platform?
TARGET = WINDOWS ? "windows-x64" : "macos-arm64"
RUBY_ASSETS = {
  "macos-arm64" => ["macos-arm64", "5c76fb1a8fdc991f524c9df94188cfe76bba23c6ac84393ad68a3014ce4f62a8"],
  "windows-x64" => ["windows-x86_64", "25105b5a0e43bf3a41591f926ac9b033c482d1787a7c6e150b33c200d41ab5d0"]
}.freeze
abort "Build on Windows x64 or an Apple silicon Mac." unless WINDOWS || RUBY_PLATFORM.include?("arm64-darwin")

def run(*command, **options)
  system(*command, **options) || abort("Failed: #{command.join(' ')}")
end

def copy(source, target)
  FileUtils.mkdir_p(File.dirname(target))
  FileUtils.cp_r(source, target)
end

Dir.chdir(ROOT) do
  FileUtils.mkdir_p(".cache/packaging")
  asset, checksum = RUBY_ASSETS.fetch(TARGET)
  archive = ".cache/packaging/ruby-#{TARGET}.tar.gz"
  unless File.file?(archive) && Digest::SHA256.file(archive).hexdigest == checksum
    run("curl", "--fail", "--location", "--silent", "--show-error", "--retry", "2",
      "https://github.com/trubygems/traveling-ruby/releases/download/rel-20251122/traveling-ruby-20251122-3.4.7-#{asset}.tar.gz", "--output", archive)
  end
  abort "Ruby runtime checksum mismatch." unless Digest::SHA256.file(archive).hexdigest == checksum

  bundle = File.join(ROOT, "dist", WINDOWS ? "Aljam3" : "Aljam3.app")
  resources = File.join(bundle, WINDOWS ? "resources" : "Contents/Resources")
  binary_dir = WINDOWS ? bundle : File.join(bundle, "Contents/MacOS")
  FileUtils.rm_rf(bundle)
  FileUtils.mkdir_p([binary_dir, File.join(resources, "ruby")])
  run("tar", "-xzf", archive, "-C", File.join(resources, "ruby"))
  if WINDOWS
    # Ruby resolves its own libraries before boot.rb runs. Keep Unicode paths
    # intact from process startup without changing the machine's system locale.
    %w[ruby rubyw].each do |name|
      ruby_exe = File.join(resources, "ruby/bin.real/#{name}.exe")
      manifest = File.join(ROOT, ".cache/packaging/#{name}.manifest")
      run("mt.exe", "-nologo", "-inputresource:#{ruby_exe};#1", "-out:#{manifest}")
      run("mt.exe", "-nologo", "-manifest", manifest, "packaging/windows-ruby.manifest", "-outputresource:#{ruby_exe};#1")
    end
  else
    run("git", "apply", "--directory", File.join(resources, "ruby").delete_prefix("#{ROOT}/"), "packaging/openssl-crl.patch")
  end
  %w[app.rb lib assets].each { |path| copy(path, File.join(resources, "app", path)) }
  %w[pdfium tokenizer].each { |name| copy("vendor/#{name}", File.join(resources, "app/vendor", name)) }
  %w[lib lacci/lib scarpe-components/lib CHANGELOG.md LICENSE.txt docs/static/manual.md].each do |path|
    copy("vendor/scarpe/#{path}", File.join(resources, "scarpe", path))
  end
  copy("vendor/scarpe/native/assets/fonts", File.join(resources, "licenses/scarpe-fonts"))
  copy("packaging/boot.rb", File.join(resources, "boot.rb"))
  copy("README.md", File.join(WINDOWS ? bundle : resources, "README.md"))
  gems = %w[base64 logger ffi sqlite3 chunky_png].map { |name| Gem::Specification.find_by_name(name) }
  gems.each do |spec|
    abort "Use precompiled native gems when packaging: #{spec.full_name}" unless spec.extensions.empty?
    copy(spec.full_gem_path, File.join(resources, "gems/gems", spec.full_name))
    target = File.join(resources, "gems/specifications", "#{spec.full_name}.gemspec")
    FileUtils.mkdir_p(File.dirname(target))
    File.write(target, spec.to_ruby_for_cache)
  end
  renderer = "scarpe-native#{'.exe' if WINDOWS}"
  copy("vendor/scarpe/native/target/release/#{renderer}", File.join(binary_dir, renderer))
  revision = IO.popen(["git", "rev-parse", "HEAD"], &:read).strip
  File.write(File.join(resources, "build.json"), JSON.pretty_generate({ version: "0.0.1", revision:, target: TARGET,
    ruby: "3.4.7", scarpe: "47256367a4d3cefbb39756d8c3287814db72e927", gems: gems.map(&:full_name) }))

  if WINDOWS
    resource = File.join(ROOT, ".cache/packaging/aljam3.res")
    linker = ENV.fetch("CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER") { File.join(ENV.fetch("VCToolsInstallDir"), "bin/Hostx64/x64/link.exe") }
    run("rc", "/nologo", "/fo", resource, "packaging/windows-icon.rc")
    run("rustc", "packaging/windows-launcher.rs", "--edition", "2021", "-O", "-C", "target-feature=+crt-static",
      "-C", "linker=#{linker}", "-C", "link-arg=#{resource}", "-o", File.join(bundle, "Aljam3.exe"))
  else
    copy("packaging/macos-launcher", File.join(binary_dir, "aljam3"))
    FileUtils.chmod(0o755, File.join(binary_dir, "aljam3"))
    copy("packaging/Info.plist", File.join(bundle, "Contents/Info.plist"))
    %w[ar en].each { |language| copy("packaging/#{language}.lproj", File.join(resources, "#{language}.lproj")) }
    iconset = File.join(ROOT, ".cache/packaging/aljam3.iconset")
    FileUtils.mkdir_p(iconset)
    [16, 32, 128, 256, 512].each do |size|
      [1, 2].each do |scale|
        run("sips", "-z", (size * scale).to_s, (size * scale).to_s, "assets/brand/app-icon.png",
          "--out", File.join(iconset, "icon_#{size}x#{size}#{'@2x' if scale == 2}.png"), out: File::NULL)
      end
    end
    run("iconutil", "-c", "icns", iconset, "-o", File.join(resources, "aljam3.icns"))
    # Sign nested Mach-O code first, including the tokenizer's .so and Ruby extensions.
    Dir.glob(File.join(bundle, "**/*")).select { |path| File.file?(path) && !File.symlink?(path) }.each do |path|
      next unless %w[cffaedfe cefaedfe cafebabe].include?(File.binread(path, 4).unpack1("H*"))

      run("codesign", "--force", "--sign", "-", "--timestamp=none", path, out: File::NULL, err: File::NULL)
    end
    run("codesign", "--force", "--sign", "-", "--timestamp=none", bundle)
    run("codesign", "--verify", "--deep", "--strict", bundle)
  end
  puts "Packaged #{bundle}"
end
