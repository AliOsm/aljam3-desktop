#!/usr/bin/env ruby
# frozen_string_literal: true

# Recheck Ruby-only updater fixes using previously built, verified native code.
require "fileutils"
require "json"
abort "Use a disposable Mac CI runner" unless ENV["GITHUB_ACTIONS"] == "true" && RUBY_PLATFORM.include?("darwin")
root = File.expand_path("..", __dir__)
def run(*command, **options)
  raise "Command failed: #{command.first}" unless system(*command, **options)
end
FileUtils.mkdir_p("dist")
%w[0.0.1 0.0.2].each do |version|
  FileUtils.rm_rf("dist/Aljam3.app")
  run("ditto", "-x", "-k", "input/Aljam3-#{version}-macos-arm64.zip", "dist")
  resources = File.join(root, "dist/Aljam3.app/Contents/Resources")
  FileUtils.cp_r("lib", File.join(resources, "app"))
  File.write(File.join(resources, "app/lib/aljam3/version.rb"), "module Aljam3; VERSION = #{version.inspect}; end\n")
  run("codesign", "--force", "--sign", "-", "--timestamp=none", "dist/Aljam3.app")
  run("codesign", "--verify", "--deep", "--strict", "dist/Aljam3.app")
  run("ruby", "bin/archive-package")
end
resources = File.join(root, "dist/Aljam3.app/Contents/Resources")
seed = File.join(root, ".cache/update-seed.rb")
FileUtils.mkdir_p(".cache")
File.write(seed, <<~RUBY)
  require "rubygems"
  Gem.use_paths(#{File.join(resources, 'gems').inspect}, [#{File.join(resources, 'ruby/lib/ruby/gems/3.4.0').inspect}])
  require #{File.join(resources, 'app/lib/aljam3').inspect}
  directory = #{File.join(root, '.cache/smoke').inspect}
  store = Aljam3::Store.new(File.join(directory, "library.sqlite3"))
  Aljam3::Downloader.new(api: Aljam3::API.new, store: store, directory: File.join(directory, "books")).call(1)
  store.close
RUBY
run({ "SQLITE_TOKENIZER_AR_EXTENSION" => nil }, File.join(resources, "ruby/bin/ruby"), seed)
run("ruby", "bin/sign-release", "dist", "0.0.2")
run("ruby", "bin/verify-update")
