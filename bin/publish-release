#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "tempfile"
require "digest"
require_relative "../lib/aljam3/version"
directory = File.expand_path(ARGV.shift || "dist")
versions = ARGV.empty? ? [Aljam3::VERSION] : ARGV
draft = ENV["ALJAM3_RELEASE_DRAFT"] == "true"
versions.each do |version|
  notes_path = File.expand_path("../docs/releases/#{version}.md", __dir__)
  versioned_notes = File.file?(notes_path) ? File.read(notes_path) : nil
  if ENV["ALJAM3_REQUIRE_RELEASE_NOTES"] == "true" && versioned_notes.to_s.strip.empty?
    abort "Versioned release notes are required: #{notes_path}"
  end
  names = ["Aljam3-#{version}-macos-arm64.dmg", "Aljam3-#{version}-windows-x64-setup.exe"]
  files = names.flat_map { |name| [File.join(directory, name), File.join(directory, "#{name}.sha256")] }
  abort "Both platform packages and checksums are required" unless files.all? { |file| File.file?(file) }
  names.each do |name|
    path = File.join(directory, name)
    abort "Package checksum mismatch: #{name}" unless Digest::SHA256.file(path).hexdigest == File.read("#{path}.sha256").split.first
  end
  abort "Release already exists: v#{version}" if system("gh", "release", "view", "v#{version}", out: File::NULL, err: File::NULL)
  abort "Signing failed" unless system("ruby", File.join(__dir__, "sign-release"), directory, version)
  feed = File.join(directory, "update.json")
  FileUtils.cp(File.join(directory, "update-#{version}.json"), feed)
  Tempfile.create("aljam3-release-notes") do |notes|
    notes.write("الجامع لسطح المكتب — الإصدار #{version}\n\n")
    if versions.length > 1
      notes.write("إصدار مؤقت لاختبار التحديث: ثبّت 0.0.1 ثم استخدم زر التحديث داخل التطبيق للانتقال إلى 0.0.2.\n\n")
    end
    notes.write("الجديد في هذا الإصدار:\n\n")
    notes.write("- إصلاح تعارض قاعدة البيانات عند بدء تنزيل تصنيف أو إضافة فاصل أثناء تنزيل الكتب في الخلفية.\n")
    notes.write("- تحسين التنزيل على الاتصالات البطيئة وإعادة المحاولة تلقائيًا عند انقطاع الاتصال، مع الاحتفاظ بملفات PDF والنصوص المحفوظة.\n")
    notes.write("- إيقاف بقية تنزيلات التصنيف مؤقتًا عند استمرار تعذّر الاتصال، لتتمكن من متابعتها لاحقًا دون فقدان التقدم.\n")
    notes.write("- استجابة أسرع للإيقاف والإلغاء أثناء انتظار الشبكة، وتحسين استعادة اتصال قارئ PDF.\n")
    notes.write("- إبقاء رسائل اختيار مجلد غير مناسب واضحة للمستخدم دون احتسابها أخطاء في التطبيق.\n\n")
    notes.write("- **ويندوز 10 و11:** نزّل ملف `Aljam3-#{version}-windows-x64-setup.exe` وشغّل المثبّت. يعمل على أجهزة x64 وعلى ويندوز 11 ARM بالمحاكاة.\n")
    notes.write("- **ماك بمعالج Apple silicon، إصدار macOS 13 فأحدث:** افتح ملف `Aljam3-#{version}-macos-arm64.dmg`، واسحب التطبيق إلى مجلد التطبيقات، ثم افتحه من هناك.\n\n")
    notes.write("قد يظهر تنبيه أمني لأن التطبيقات غير موقّعة بشهادة مطوّر وغير موثّقة لدى Apple. في ماك، يمكنك السماح بالتشغيل من «إعدادات النظام ← الخصوصية والأمان ← فتح على أي حال».\n\n")
    notes.write("للتحديث من نسخة سابقة، افتح تحديثات التطبيق واختر «إعادة التشغيل والتحديث». تبقى مكتبتك وبيانات القراءة محفوظة.\n")
    if versioned_notes
      notes.rewind
      notes.truncate(0)
      notes.write(versioned_notes)
    end
    notes.flush
    revision = ENV.fetch("GITHUB_SHA") { IO.popen(["git", "rev-parse", "HEAD"], &:read).strip }
    tag = "refs/tags/v#{version}"
    references = IO.popen(["git", "ls-remote", "--tags", "origin", tag, "#{tag}^{}"], &:read)
    abort "Could not verify release tag" unless $?.success?
    references = references.lines.to_h { |line| sha, name = line.split; [name, sha] }
    tagged_revision = references["#{tag}^{}"] || references[tag]
    abort "Release tag points to a different build" if tagged_revision && tagged_revision != revision
    # Existing tags need no new workflow-writing permission for older build commits.
    target = tagged_revision ? ["--verify-tag"] : ["--target", revision]
    license = File.expand_path("../packaging/Sparkle-LICENSE.txt", __dir__)
    abort "Draft release creation failed" unless system("gh", "release", "create", "v#{version}", *files, feed, license,
      "--draft", *target, "--title", "الجامع #{version}", "--notes-file", notes.path)
    unless draft
      abort "Release publication failed" unless system("gh", "release", "edit", "v#{version}", "--draft=false", "--latest")
    end
  end
end
