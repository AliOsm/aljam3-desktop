#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "rbconfig"
require "tmpdir"
require "digest"

ROOT = File.expand_path("..", __dir__)
SCARPE_REVISION = "47256367a4d3cefbb39756d8c3287814db72e927"
TOKENIZER_REVISION = "049d3c496209be1a68712b841d3198128761c3f3"
TOKENIZER_SOURCE_CHECKSUM = "f7e9217dc66ca78306e257d816175e18f4002022c3155f75f0d283089f81263c"
TOKENIZER_CHECKSUMS = {
  "linux-x64" => "521ff550863b8a8d4636a9c96b68a4445d497b897edc6b9d4fba679acf396705",
  "linux-arm64" => "5896a9cd536c27430527782d9ac95eb1c6e69bba50410eaf900d51b4244f312d",
  "windows-x64" => "9167b689232b1bee91a7b7949401d55a56b76c0423088e536217d966fdbcb840"
}.freeze

def run(*command, **options)
  system(*command, **options) || abort("Failed: #{command.join(' ')}")
end

def fetch(url, destination, checksum:)
  FileUtils.mkdir_p(File.dirname(destination))
  run("curl", "--fail", "--location", "--silent", "--show-error", "--retry", "2", url, "--output", "#{destination}.part")
  abort "Checksum mismatch for #{url}" unless Digest::SHA256.file("#{destination}.part").hexdigest == checksum
  File.rename("#{destination}.part", destination)
end

def patches_applied?(directory, patches)
  # Later patches can change an earlier patch's context. Reverse the complete
  # series in a scratch copy, keeping the developer's checkout untouched.
  Dir.mktmpdir("aljam3-patch-check-") do |scratch|
    paths = patches.flat_map { |patch| File.read(patch).scan(/^(?:--- a|\+\+\+ b)\/(.+)$/).flatten }.uniq
    paths.each do |path|
      source, target = File.join(directory, path), File.join(scratch, path)
      next unless File.file?(source)

      FileUtils.mkdir_p(File.dirname(target))
      FileUtils.cp(source, target)
    end
    patches.reverse.all? { |patch| system("git", "apply", "--reverse", patch, chdir: scratch, out: File::NULL, err: File::NULL) }
  end
end

Dir.chdir(ROOT) do
  FileUtils.mkdir_p("vendor")
  unless File.directory?("vendor/scarpe/.git")
    run("git", "clone", "--no-checkout", "--depth", "1", "https://github.com/scarpe-team/scarpe.git", "vendor/scarpe")
    run("git", "-C", "vendor/scarpe", "fetch", "--depth", "1", "origin", SCARPE_REVISION)
    run("git", "-C", "vendor/scarpe", "checkout", "--detach", SCARPE_REVISION)
  end
  revision = IO.popen(["git", "-C", "vendor/scarpe", "rev-parse", "HEAD"], &:read).strip
  abort "Expected Scarpe #{SCARPE_REVISION}, found #{revision}." unless revision == SCARPE_REVISION

  patches = Dir.glob(File.join(ROOT, "patches/*.patch")).sort
  unless patches_applied?("vendor/scarpe", patches)
    patches.each do |patch|
      unless system("git", "-C", "vendor/scarpe", "apply", "--reverse", "--check", patch, out: File::NULL, err: File::NULL)
        run("git", "-C", "vendor/scarpe", "apply", "--check", patch)
        run("git", "-C", "vendor/scarpe", "apply", patch)
      end
    end
  end
  exit if ARGV.include?("--prepare")

  run("bundle", "install")
  run("cargo", "build", "--release", "--locked", "--manifest-path", "vendor/scarpe/native/Cargo.toml")

  os = case RbConfig::CONFIG["host_os"]
       when /darwin/ then "mac"
       when /linux/ then "linux"
       when /mingw|mswin/ then "win"
       else abort "Unsupported operating system."
       end
  cpu = RbConfig::CONFIG["host_cpu"]
  arch = case cpu
         when /x86_64|amd64|x64/ then "x64"
         when /aarch64|arm64/ then "arm64"
         else abort "Unsupported architecture: #{cpu}"
         end

  run(RbConfig.ruby, "bin/build-pdfium")

  tokenizer_platform = "#{{ 'mac' => 'macos', 'win' => 'windows' }.fetch(os, os)}-#{arch}"
  tokenizer_version = "0.1.13-#{tokenizer_platform}"
  tokenizer_version += "-macos13" if os == "mac"
  unless File.file?("vendor/tokenizer/VERSION") && File.read("vendor/tokenizer/VERSION").strip == tokenizer_version
    Dir.mktmpdir("aljam3-tokenizer") do |temporary|
      archive = File.join(temporary, "tokenizer.tar.gz")
      FileUtils.mkdir_p("vendor/tokenizer")
      if os == "mac"
        # The upstream macOS binary declares macOS 26; build the same release for macOS 13.
        fetch("https://github.com/yshalsager/sqlite-tokenizer-ar/archive/#{TOKENIZER_REVISION}.tar.gz", archive,
          checksum: TOKENIZER_SOURCE_CHECKSUM)
        run("tar", "-xzf", File.basename(archive), "--strip-components=1", "-C", temporary, chdir: temporary)
        # Match the bundled sqlite3 gem; Apple's SDK headers bind directly to system SQLite.
        fetch("https://sqlite.org/2026/sqlite-autoconf-3530200.tar.gz", File.join(temporary, "sqlite.tar.gz"),
          checksum: "588ad51949419a56ebe81fe56193d510c559eb94c9a57748387860b5d3069316")
        run("tar", "-xzf", "sqlite.tar.gz", "--strip-components=1", "-C", temporary,
          "sqlite-autoconf-3530200/sqlite3.h", "sqlite-autoconf-3530200/sqlite3ext.h", chdir: temporary)
        run("cc", "-O2", "-fPIC", "-dynamiclib", "-I#{temporary}", "-mmacosx-version-min=13.0",
          File.join(temporary, "tokenizer/src/sqlite_tokenizer_ar.c"), "-o", "vendor/tokenizer/sqlite_tokenizer_ar.so")
        %w[LICENSE THIRD_PARTY_NOTICES.md].each { |name| FileUtils.cp(File.join(temporary, name), "vendor/tokenizer") }
      else
        fetch("https://github.com/yshalsager/sqlite-tokenizer-ar/releases/download/v0.1.13/sqlite-tokenizer-ar-#{tokenizer_platform}.tar.gz",
          archive, checksum: TOKENIZER_CHECKSUMS.fetch(tokenizer_platform))
        run("tar", "-xzf", File.basename(archive), "-C", File.join(ROOT, "vendor/tokenizer"), chdir: temporary)
      end
      File.write("vendor/tokenizer/VERSION", tokenizer_version)
    end
  end

  puts "Ready. Run mise run start to open the app, or mise run test to check it."
end
