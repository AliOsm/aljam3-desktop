#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "digest"
require "json"
root = File.expand_path("..", __dir__)
windows = Gem.win_platform?
resources = windows ? "Aljam3/resources" : "Aljam3.app/Contents/Resources"
build = JSON.parse(File.read(File.join(root, "dist", resources, "build.json")))
archive = File.join(root, "dist", "Aljam3-#{build.fetch('version')}-#{build.fetch('target')}.zip")
FileUtils.rm_f(archive)
command = if windows
  ["7z", "a", "-tzip", archive, "Aljam3"]
else
  ["ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", "Aljam3.app", archive]
end
abort "Archiving failed" unless system(*command, chdir: File.join(root, "dist"))
File.write("#{archive}.sha256", "#{Digest::SHA256.file(archive).hexdigest}  #{File.basename(archive)}\n")
puts archive
