+TEST_F(DocumentTest, SkipUnvisitedPageBranches) {
+  auto document = std::make_unique<CPDF_TestDocumentForPages>();
+  auto page = document->GetPageDictionary(6);
+  ASSERT_TRUE(page);
+  EXPECT_EQ(6, page->GetIntegerFor("PageNumbering"));
+  for (int i = 0; i < 6; ++i) {
+    EXPECT_FALSE(document->IsPageLoaded(i));
+  }
+
+  // Earlier pages are no longer necessarily cached. Backward and forward
+  // navigation must restart or resume traversal at the right page index.
+  for (int i : {4, 1, 5, 0, 3, 2, 6}) {
+    page = document->GetPageDictionary(i);
+    ASSERT_TRUE(page);
+    EXPECT_EQ(i, page->GetIntegerFor("PageNumbering"));
+  }
+}
