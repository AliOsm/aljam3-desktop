+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDF_GetPageIndexObjectOffsets(FPDF_DOCUMENT document,
+                              int page_index,
+                              unsigned long long* offsets,
+                              unsigned long capacity) {
+  auto* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc || !doc->GetParser() || !offsets || !capacity ||
+      page_index < 0 || page_index >= doc->GetPageCount()) {
+    return 0;
+  }
+  auto* root = doc->GetRoot();
+  auto pages = root ? root->GetDictFor(pdfium::catalog::kPages) : nullptr;
+  auto kids = pages ? pages->GetArrayFor("Kids") : nullptr;
+  if (!kids || kids->size() != static_cast<size_t>(doc->GetPageCount())) {
+    return 0;
+  }
+  unsigned long written = 0;
+  for (int index = 0; index <= page_index && written < capacity; ++index) {
+    auto object = kids->GetObjectAt(index);
+    auto* reference = object ? object->AsReference() : nullptr;
+    if (!reference || doc->GetIndirectObject(reference->GetRefObjNum())) {
+      continue;
+    }
+    const auto offset = doc->GetParser()->GetObjectPositionOrZero(
+        reference->GetRefObjNum());
+    if (offset > 0 && offset < doc->GetParser()->GetDocumentSize()) {
+      offsets[written++] = static_cast<unsigned long long>(offset);
+    }
+  }
+  return written;
+}
