+namespace {
+
+class FailingStreamRead final : public CFX_ReadOnlySpanStream {
+ public:
+  CONSTRUCT_VIA_MAKE_RETAIN;
+
+  bool ReadBlockAtOffset(pdfium::span<uint8_t> buffer,
+                         FX_FILESIZE offset) override {
+    // Allow the parser's buffered reads of the dictionary and end markers;
+    // fail only when it copies the three-byte stream body.
+    if (buffer.size() == 3u) {
+      did_fail_ = true;
+      return false;
+    }
+    return CFX_ReadOnlySpanStream::ReadBlockAtOffset(buffer, offset);
+  }
+
+  bool did_fail() const { return did_fail_; }
+
+ private:
+  explicit FailingStreamRead(pdfium::span<const uint8_t> data)
+      : CFX_ReadOnlySpanStream(data) {}
+  ~FailingStreamRead() override = default;
+
+  bool did_fail_ = false;
+};
+
+}  // namespace
+
+TEST(SyntaxParserTest, StreamDataReadFailure) {
+  // Exercise both declared lengths and lengths recovered from endstream.
+  for (const char* data : {"<< /Length 3 >>\nstream\nabc\nendstream\nendobj",
+                           "<< >>\nstream\nabc\nendstream\nendobj",
+                           "<< /Length 2 >>\nstream\nabc\nendstream\nendobj"}) {
+    SCOPED_TRACE(data);
+    CPDF_SyntaxParser readable_parser(
+        pdfium::MakeRetain<CFX_ReadOnlySpanStream>(
+            ByteStringView(data).unsigned_span()));
+    auto object = readable_parser.GetObjectBody(nullptr);
+    ASSERT_TRUE(object);
+    EXPECT_TRUE(object->IsStream());
+
+    auto source = pdfium::MakeRetain<FailingStreamRead>(
+        ByteStringView(data).unsigned_span());
+    CPDF_SyntaxParser parser(source);
+    EXPECT_FALSE(parser.GetObjectBody(nullptr));
+    EXPECT_TRUE(source->did_fail());
+    EXPECT_TRUE(parser.GetValidator()->has_read_problems());
+  }
+}
