+#[test]
+fn night_mode_is_cached_display_only_and_survives_resizing_and_rewrites() {
+    let path = scratch("night-mode").join("page.png");
+    png(&path, 20, [255, 255, 255]);
+    let original = std::fs::read(&path).unwrap();
+    let mut h = Harness::new();
+    h.feed(&app(200, 100, &[
+        create(3, "Image", 2, json!({"url": path, "width": 80, "height": 80, "night_mode": true})),
+        create(4, "Image", 2, json!({"url": path, "left": 100, "width": 80, "height": 80})),
+    ]));
+    assert_eq!(pixel(&mut h, 40.0, 40.0), json!([30, 27, 26, 255]));
+    assert_eq!(pixel(&mut h, 140.0, 40.0), json!([255, 255, 255, 255]));
+    assert_eq!(std::fs::read(&path).unwrap(), original);
+    let resampled = h.rt.stats.counter("images_resampled");
+    for _ in 0..3 { pixel(&mut h, 40.0, 40.0); }
+    assert_eq!(h.rt.stats.counter("images_resampled"), resampled);
+    h.feed(&format!("{}\n{{\"t\":\"flush\"}}\n", json!({"t": "props", "id": 3, "props": {"night_mode": false}})));
+    assert_eq!(pixel(&mut h, 40.0, 40.0), json!([255, 255, 255, 255]));
+    h.feed(&format!("{}\n{{\"t\":\"flush\"}}\n", json!({"t": "props", "id": 3, "props": {"night_mode": true, "width": 60}})));
+    assert_eq!(pixel(&mut h, 30.0, 40.0), json!([30, 27, 26, 255]));
+    png(&path, 25, [0, 0, 0]);
+    set_url(&mut h, 3, path.to_str().unwrap());
+    assert_eq!(pixel(&mut h, 30.0, 40.0), json!([232, 226, 213, 255]));
+}
