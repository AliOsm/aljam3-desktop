+    /// A display-only night variant. The original pixels and exported file stay intact.
+    pub fn in_mode(&mut self, path: &Path, night: bool) -> Option<Rc<Pixmap>> {
+        let image = self.get(path)?;
+        if !night { return Some(image); }
+        let entry = self.entries.get_mut(path)?;
+        if entry.night.is_none() {
+            let mut copy = image.as_ref().clone();
+            for px in copy.data_mut().chunks_exact_mut(4) {
+                // Work in premultiplied space, preserving transparency and mapping
+                // paper to warm charcoal, ink to a soft off-white.
+                let a = px[3] as u32;
+                let luma = (54 * px[0] as u32 + 183 * px[1] as u32 + 19 * px[2] as u32) / 256;
+                for (i, (paper, ink)) in [(30u32, 232u32), (27, 226), (26, 213)].into_iter().enumerate() {
+                    px[i] = ((paper * a + (ink - paper) * (a - luma) + 127) / 255) as u8;
+                }
+            }
+            entry.night = Some(Rc::new(copy));
+        }
+        entry.night.clone()
     }
 
