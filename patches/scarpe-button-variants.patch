+#[test]
+fn flat_button_variants_paint_their_surface_and_still_activate_with_keys() {
+    for variant in ["solid", "outline", "ghost"] {
+        let mut h = Harness::new();
+        h.feed(&app(200, 100, &[
+            create(3, "Button", 2, json!({"text":"", "variant":variant, "color":"#ae4721", "border_color":"#ede6dc", "left":20, "top":20, "width":80, "height":36})),
+        ]));
+        let top = h.value(json!({"op":"pixel", "x":40, "y":26}));
+        let bottom = h.value(json!({"op":"pixel", "x":40, "y":47}));
+        assert_eq!(top, json!([174, 71, 33, 255]), "{variant} uses its exact surface color");
+        assert_eq!(bottom, top, "{variant} has no legacy gradient");
+        h.value(json!({"op":"key", "key":"tab"}));
+        let (msgs, _) = h.req(json!({"op":"key", "key":"enter"}));
+        assert!(named(&events(&msgs), "click").iter().any(|e| e.1 == json!(3)));
+    }
+}
+
+#[test]
+fn ghost_buttons_are_clear_until_hover_and_disabled_buttons_cannot_activate() {
+    let mut h = Harness::new();
+    h.feed(&app(200, 100, &[
+        create(3, "Button", 2, json!({"text":"", "variant":"ghost", "color":"transparent", "left":20, "top":20, "width":80, "height":36})),
+    ]));
+    let outside = h.value(json!({"op":"pixel", "x":120, "y":40}));
+    assert_eq!(h.value(json!({"op":"pixel", "x":40, "y":40})), outside);
+    h.value(json!({"op":"mouse", "action":"move", "x":40, "y":40}));
+    assert_ne!(h.value(json!({"op":"pixel", "x":40, "y":40})), outside, "hover is visible");
+    h.feed(&format!("{}\n{}\n", json!({"t":"props","id":3,"props":{"state":"disabled"}}), json!({"t":"flush"})));
+    let (msgs, _) = h.req(json!({"op":"click", "target":{"id":3}}));
+    assert!(named(&events(&msgs), "click").is_empty());
+}
