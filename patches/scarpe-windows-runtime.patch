 enum Sink {
-    Stdout,
+    Stdout(OutputWriter),
     Capture,
+}
+
+/// A busy Ruby handler must not block presentation by leaving stdout unread.
+/// Keep ordering and backpressure, but allow a short transition to finish while
+/// the pipe drains. The bounded queue prevents an unresponsive parent growing
+/// memory indefinitely; dropping it flushes outstanding replies before exit.
+struct OutputWriter {
+    sender: Option<std::sync::mpsc::SyncSender<Vec<u8>>>,
+    thread: Option<std::thread::JoinHandle<()>>,
+    broken: std::sync::Arc<std::sync::atomic::AtomicBool>,
+}
+
+impl OutputWriter {
+    fn new(mut writer: impl Write + Send + 'static) -> Self {
+        let (sender, receiver) = std::sync::mpsc::sync_channel::<Vec<u8>>(32);
+        let broken = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let failed = broken.clone();
+        let thread = std::thread::spawn(move || {
+            for bytes in receiver {
+                if writer.write_all(&bytes).and_then(|_| writer.flush()).is_err() {
+                    failed.store(true, std::sync::atomic::Ordering::Relaxed);
+                    break;
+                }
+            }
+        });
+        Self { sender: Some(sender), thread: Some(thread), broken }
+    }
+
+    fn failed(&self) -> bool { self.broken.load(std::sync::atomic::Ordering::Relaxed) }
+
+    fn send(&self, bytes: Vec<u8>) -> bool {
+        self.sender.as_ref().is_some_and(|sender| sender.send(bytes).is_ok())
+    }
+}
+
+impl Drop for OutputWriter {
+    fn drop(&mut self) {
+        self.sender.take();
+        if let Some(thread) = self.thread.take() { let _ = thread.join(); }
+    }
 }
 
