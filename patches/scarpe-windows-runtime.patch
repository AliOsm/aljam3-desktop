--- /dev/null
+++ b/native/tests/clipboard.rs
@@ -0,0 +1,18 @@
+mod common;
+
+use common::{app, create, Harness};
+use serde_json::json;
+
+#[test]
+fn clipboard_requests_share_the_headless_clipboard_with_text_fields() {
+    let mut h = Harness::new();
+    h.feed(&app(300, 100, &[create(3, "EditLine", 2, json!({"text":""}))]));
+    h.value(json!({"op":"clipboard", "text":"آدابُ العلم\nصفحة ٧٢"}));
+    assert_eq!(h.value(json!({"op":"clipboard"})), json!("آدابُ العلم\nصفحة ٧٢"));
+    h.value(json!({"op":"clipboard", "text":"العلم"}));
+    h.value(json!({"op":"click", "target":{"id":3}}));
+    h.value(json!({"op":"key", "key":"control_v"}));
+    assert_eq!(h.node(|n| n["id"] == 3)["text"], json!("العلم"));
+    h.value(json!({"op":"clipboard", "text":""}));
+    assert_eq!(h.value(json!({"op":"clipboard"})), json!(""));
+}
