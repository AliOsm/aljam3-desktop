+#[test]
+fn rich_paragraph_word_line_and_shift_selection_survive_resize() {
+    let mut h = Harness::new();
+    h.feed(&app(500, 240, &[create(3, "Para", 2, json!({"text_items":["hello world\nsecond line"], "selectable":true, "size":24}))]));
+    let (x, y) = text_point(&mut h, 3, 2);
+    for _ in 0..2 {
+        h.value(json!({"op":"click","target":{"x":x,"y":y}}));
+    }
+    h.value(json!({"op":"key","key":"control_c"}));
+    assert_eq!(h.value(json!({"op":"clipboard"})), json!("hello"));
+    h.value(json!({"op":"click","target":{"x":x,"y":y}}));
+    h.value(json!({"op":"key","key":"control_c"}));
+    assert!(h.value(json!({"op":"clipboard"})).as_str().unwrap().starts_with("hello world"));
+    h.value(json!({"op":"key","key":"control_home"}));
+    h.value(json!({"op":"key","key":"control_shift_end"}));
+    h.value(json!({"op":"resize","w":180,"h":240}));
+    h.value(json!({"op":"key","key":"control_c"}));
+    assert_eq!(h.value(json!({"op":"clipboard"})), json!("hello world\nsecond line"));
