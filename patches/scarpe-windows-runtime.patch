+fn read_only_paragraphs_select_arabic_by_drag_and_copy_only_the_selection() {
+    let mut h = Harness::new();
+    h.feed(&app(500, 240, &[create(3, "Para", 2, json!({"text_items":["العِلْم نور\nكتاب جديد"], "selectable":true, "size":24, "direction":"rtl"}))]));
