+++ b/native/src/window/activity.rs
@@ -0,0 +1,75 @@
+//! Window activity contains no input content. Reports are coalesced so pointer
+//! movement cannot flood Ruby or disturb rendering and scrolling.
+
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+pub(super) struct Activity {
+    focused: bool,
+    occluded: bool,
+    last_report: Option<Instant>,
+}
+
+impl Activity {
+    pub fn focus(&mut self, focused: bool) -> Option<bool> {
+        let before = self.active();
+        self.focused = focused;
+        self.changed(before)
+    }
+
+    pub fn occlude(&mut self, occluded: bool) -> Option<bool> {
+        let before = self.active();
+        self.occluded = occluded;
+        self.changed(before)
+    }
+
+    fn active(&self) -> bool { self.focused && !self.occluded }
+
+    fn changed(&mut self, before: bool) -> Option<bool> {
+        if before == self.active() { return None; }
+        self.last_report = None;
+        Some(self.active())
+    }
+
+    pub fn input(&mut self, now: Instant) -> bool {
+        if !self.active() || self.last_report.is_some_and(|last| now.duration_since(last) < Duration::from_secs(1)) {
+            return false;
+        }
+        self.last_report = Some(now);
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn background_and_occluded_windows_do_not_report_input() {
+        let mut activity = Activity::default();
+        let now = Instant::now();
+        assert!(!activity.input(now));
+        assert_eq!(activity.focus(true), Some(true));
+        assert!(activity.input(now));
+        assert_eq!(activity.occlude(true), Some(false));
+        assert!(!activity.input(now + Duration::from_secs(3)));
+        assert_eq!(activity.focus(false), None);
+        assert_eq!(activity.occlude(false), None);
+        assert!(!activity.input(now + Duration::from_secs(4)));
+        assert_eq!(activity.focus(true), Some(true));
+        assert!(activity.input(now + Duration::from_secs(4)));
+    }
+
+    #[test]
+    fn pointer_input_is_coalesced_but_refocusing_reports_immediately() {
+        let mut activity = Activity::default();
+        let now = Instant::now();
+        activity.focus(true);
+        assert!(activity.input(now));
+        for offset in 1..1000 { assert!(!activity.input(now + Duration::from_millis(offset))); }
+        assert!(activity.input(now + Duration::from_secs(1)));
+        assert_eq!(activity.focus(false), Some(false));
+        assert_eq!(activity.focus(true), Some(true));
+        assert!(activity.input(now + Duration::from_millis(1001)));
+    }
+}
