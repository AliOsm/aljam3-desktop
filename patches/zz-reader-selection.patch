+
+#[test]
+fn selected_text_queries_preserve_arabic_selection_and_leave_the_clipboard_alone() {
+    let mut h = Harness::new();
+    h.feed(&app(500, 240, &[
+        create(3, "Para", 2, json!({"text_items":["العِلْم نور\nكتاب جديد"], "selectable":true, "size":24, "direction":"rtl"})),
+        create(4, "Para", 2, json!({"text_items":["Another paragraph"], "selectable":true})),
+    ]));
+    h.value(json!({"op":"clipboard", "text":"sentinel"}));
+    assert_eq!(h.value(json!({"op":"para_selection", "id":3})), json!(null));
+    let (x, y) = text_point(&mut h, 3, 0);
+    let (ex, ey) = text_point(&mut h, 3, 7);
+    h.value(json!({"op":"mouse", "action":"down", "x":x, "y":y}));
+    h.value(json!({"op":"mouse", "action":"move", "x":ex, "y":ey}));
+    h.value(json!({"op":"mouse", "action":"up", "x":ex, "y":ey}));
+    h.value(json!({"op":"click", "target":{"x":ex,"y":ey}, "button":3}));
+    assert_eq!(h.value(json!({"op":"para_selection", "id":3})), json!("العِلْم"));
+    assert_eq!(h.value(json!({"op":"para_selection", "id":4})), json!(null));
+    assert_eq!(h.value(json!({"op":"clipboard"})), json!("sentinel"));
+    h.feed("{\"t\":\"props\",\"id\":3,\"props\":{\"text_items\":[\"Changed page\"]}}\n");
+    assert_eq!(h.value(json!({"op":"para_selection", "id":3})), json!(null));
+    assert_eq!(h.value(json!({"op":"clipboard"})), json!("sentinel"));
+}
