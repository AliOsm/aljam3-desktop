diff --git a/native/tests/text_input.rs b/native/tests/text_input.rs
index c20739e..7c5855d 100644
--- a/native/tests/text_input.rs
+++ b/native/tests/text_input.rs
@@ -270,3 +270,105 @@ fn a_fields_font_keeps_its_weight_and_slant() {
     assert!(bold.len() * 10 > plain.len() * 13, "bold puts down at least 30% more ink: {} against {}", plain.len(), bold.len());
