+#[test]
+fn window_minimums_apply_to_creation_and_resize_without_changing_unconstrained_apps() {
+    use scarpe_native::runtime::{app_min_size, app_size};
+    let props = json!({"width":420,"height":420,"min_width":800,"min_height":600});
+    assert_eq!(app_size(props.as_object().unwrap()), (800.0, 600.0));
+    assert_eq!(app_min_size(json!({"min_width":-1}).as_object().unwrap()), (0.0, 0.0));
+    let mut h = Harness::new();
+    h.feed(&app(1160, 820, &[]));
+    h.feed(&json!({"t":"props","id":1,"props":{"min_width":800,"min_height":600}}).to_string());
+    h.rt.resize_view(1, 420.0, 420.0, true);
+    assert_eq!(h.rt.views[&1].size, (800.0, 600.0));
+    let messages = h.rt.out.take_captured();
+    assert!(messages.iter().any(|m| m["t"] == "resize" && m["w"] == 800 && m["h"] == 600));
+    h.rt.resize_view(1, 0.0, 0.0, true);
+    assert_eq!(h.rt.views[&1].size, (800.0, 600.0), "minimizing retains a usable size");
+    h.rt.resize_view(1, 1000.0, 720.0, true);
+    assert_eq!(h.rt.views[&1].size, (1000.0, 720.0));
+    h.feed(&json!({"t":"props","id":1,"props":{"min_width":null,"min_height":null}}).to_string());
+    h.rt.resize_view(1, 320.0, 240.0, true);
+    assert_eq!(h.rt.views[&1].size, (320.0, 240.0));
 }
 
