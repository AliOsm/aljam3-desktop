--- a/lacci/lib/shoes/drawables/text_drawable.rb
+++ b/lacci/lib/shoes/drawables/text_drawable.rb
@@ -1,6 +1,28 @@
 # frozen_string_literal: true
 
 class Shoes
+  # By default fragments may be reused after their paragraph is removed. A view
+  # that creates disposable fragments can own them instead, releasing their
+  # registrations and event handlers on replacement or destruction.
+  module OwnedText
+    def owns_text?
+      @owns_text || (is_a?(TextDrawable) && parent.respond_to?(:owns_text?) && parent.owns_text?)
+    end
+
+    def destroy
+      release_text_children(@text_children) if owns_text?
+      super
+    end
+
+    private
+
+    def release_text_children(children)
+      Array(children).each do |child|
+        child.destroy if child.is_a?(TextDrawable) && child.parent.equal?(self)
+      end
+    end
+  end
+
