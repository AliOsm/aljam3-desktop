+
+#[test]
+fn arabic_span_highlights_cover_the_whole_word() {
+    let mut h = Harness::new();
+    h.feed(&common::app(360, 120, &[
+        json!({"t":"create","id":3,"kind":"Span","parent":2,"props":{"text_items":["العلم"],"fill":{"rgba":[174,71,33,255]}}}),
+        json!({"t":"create","id":4,"kind":"Para","parent":2,"props":{"text_items":[3],"left":20,"top":20,"width":320,"size":32,"align":"right"}}),
+    ]));
+    let path = std::env::temp_dir().join(format!("scarpe-arabic-highlight-{}.png", std::process::id()));
+    h.value(json!({"op":"snapshot","path":path.to_string_lossy(),"scale":1}));
+    let img = image::open(&path).unwrap().to_rgba8();
+    let colored = img.enumerate_pixels().filter(|(_, _, pixel)| pixel.0 == [174, 71, 33, 255]).collect::<Vec<_>>();
+    assert!(colored.len() > 500, "The Arabic word needs a visible highlight, got {} pixels", colored.len());
+    let min = colored.iter().map(|(x, _, _)| *x).min().unwrap();
+    let max = colored.iter().map(|(x, _, _)| *x).max().unwrap();
+    assert!(max - min > 40, "The highlight must span more than one glyph");
+    let _ = std::fs::remove_file(path);
+}
+
+#[test]
+fn progress_uses_its_theme_colors() {
+    let mut h = Harness::new();
+    h.feed(&common::app(240, 40, &[
+        json!({"t":"create","id":3,"kind":"Progress","parent":2,"props":{"left":10,"top":10,"width":200,"height":8,"fraction":0.5,"color":{"rgba":[174,71,33,255]},"background_color":{"rgba":[74,69,67,255]}}}),
+    ]));
+    assert_eq!(h.value(json!({"op":"pixel","x":30,"y":14})), json!([174,71,33,255]));
+    assert_eq!(h.value(json!({"op":"pixel","x":180,"y":14})), json!([74,69,67,255]));
+}
