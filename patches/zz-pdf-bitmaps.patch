 use common::{app, create, Harness};
 use serde_json::{json, Value};
 use tiny_skia::{Color, Pixmap};
+use base64::Engine;
+
+fn bitmap(h: &mut Harness, key: &str, width: u32, height: u32, bytes: &[u8]) {
+    h.feed(&format!("{}\n{{\"t\":\"flush\"}}\n", json!({
+        "t": "bitmap", "key": key, "width": width, "height": height,
+        "rgba": base64::engine::general_purpose::STANDARD.encode(bytes),
+    })));
+}
+
+#[test]
+fn worker_pixels_survive_virtualization_and_are_explicitly_released() {
+    let mut h = Harness::new();
+    h.feed(&app(200, 100, &[]));
+    bitmap(&mut h, "memory:page", 2, 2, &[255, 255, 255, 255].repeat(4));
+    h.feed(&format!("{}\n{{\"t\":\"flush\"}}\n", create(3, "Image", 2, json!({"url": "memory:page", "width": 40, "height": 40, "night_mode": true}))));
+    assert_eq!(pixel(&mut h, 20.0, 20.0), json!([30, 27, 26, 255]));
+    h.feed("{\"t\":\"destroy\",\"id\":3}\n{\"t\":\"flush\"}\n");
+    assert_eq!(h.rt.images.len(), 1, "recent pixels remain ready offscreen");
+    h.feed(&format!("{}\n{{\"t\":\"flush\"}}\n", create(4, "Image", 2, json!({"url": "memory:page", "width": 40, "height": 40}))));
+    assert_eq!(pixel(&mut h, 20.0, 20.0), json!([255, 255, 255, 255]), "night mode preserved the original pixels");
+    h.feed("{\"t\":\"destroy\",\"id\":4}\n{\"t\":\"release_bitmap\",\"key\":\"memory:page\"}\n{\"t\":\"flush\"}\n");
+    assert_eq!(h.rt.images.len(), 0);
+}
+
+#[test]
+fn worker_pixels_validate_dimensions_length_and_premultiply_alpha() {
+    let mut h = Harness::new();
+    h.feed(&app(200, 100, &[]));
+    bitmap(&mut h, "memory:page", 1, 1, &[200, 100, 50, 128]);
+    let pm = h.rt.images.get(std::path::Path::new("memory:page")).unwrap();
+    assert_eq!(pm.data(), &[100, 50, 25, 128]);
+    bitmap(&mut h, "memory:page", 2, 2, &[0, 0, 0, 255]);
+    bitmap(&mut h, "memory:huge", u32::MAX, u32::MAX, &[]);
+    bitmap(&mut h, "file.png", 1, 1, &[0, 0, 0, 255]);
+    bitmap(&mut h, "memory:empty", 0, 0, &[]);
+    assert_eq!(h.rt.images.len(), 1, "invalid uploads cannot replace valid pixels or allocate unbounded images");
+    assert_eq!(h.rt.images.get(std::path::Path::new("memory:page")).unwrap().data(), pm.data());
+}
 
