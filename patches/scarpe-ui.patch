+//! Shared geometry for painted scrollbars and pointer input, in logical pixels.
+use crate::layout::{Rect, Scroller};
+use crate::props::Id;
+
+pub struct Geometry { pub thumb: Rect, pub track: Rect, pub max_top: f32 }
+
+impl Geometry {
+    pub fn new(s: &Scroller) -> Option<Self> {
+        if s.max_top() <= 0.5 || s.viewport.h <= 4.0 { return None; }
+        let v = s.viewport;
+        let height = v.h - 4.0;
+        let thumb_height = (height * v.h / s.content_height).max(24.0).min(height);
+        let y = v.y + 2.0 + (height - thumb_height) * (s.top / s.max_top());
+        Some(Self {
+            thumb: Rect::new(if s.rtl { v.x + 3.0 } else { v.right() - 8.0 }, y, 5.0, thumb_height),
+            track: Rect::new(if s.rtl { v.x } else { v.right() - 12.0 }, v.y + 2.0, 12.0, height),
+            max_top: s.max_top(),
+        })
+    }
+
+    pub fn position(&self, y: f32, grab: f32) -> f32 {
+        let travel = self.track.h - self.thumb.h;
+        if travel <= 0.0 { return 0.0; }
+        ((y - self.track.y - grab) / travel * self.max_top).clamp(0.0, self.max_top)
+    }
+}
