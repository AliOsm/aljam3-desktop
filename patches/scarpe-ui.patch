+fn scrollbar_thumb_drag_and_track_click_work_in_both_directions() {
+    use scarpe_native::scrollbar::Geometry;
+    for direction in ["rtl", "ltr"] {
+        let mut h = Harness::new();
+        h.feed(&app(360, 220, &[
+            create(3, "Stack", 2, json!({"width":300,"height":200,"scroll":true,"direction":direction})),
+            create(4, "Stack", 3, json!({"width":250,"height":1000})),
+        ]));
+        h.layout();
+        let g = Geometry::new(&h.rt.views[&1].layout.as_ref().unwrap().scrollers[&3]).unwrap();
+        let (x, y) = (g.track.x + 6.0, g.thumb.y + 10.0);
+        h.value(json!({"op":"mouse","action":"down","x":x,"y":y}));
+        h.value(json!({"op":"mouse","action":"move","x":x,"y":y+80.0}));
+        h.value(json!({"op":"mouse","action":"up","x":x,"y":y+80.0}));
+        let top = h.rt.views[&1].ui.scroll[&3];
+        assert!(top > 300.0, "{direction}: {top}");
+        h.value(json!({"op":"mouse","action":"move","x":x,"y":y}));
+        assert_eq!(h.rt.views[&1].ui.scroll[&3], top, "released drag stops");
+        h.value(json!({"op":"click","target":{"x":x,"y":g.track.y+1.0}}));
+        assert!(h.rt.views[&1].ui.scroll[&3] < top, "track click pages up");
+        h.layout();
+        let g = Geometry::new(&h.rt.views[&1].layout.as_ref().unwrap().scrollers[&3]).unwrap();
+        h.value(json!({"op":"mouse","action":"down","x":x,"y":g.thumb.y+4.0}));
+        h.value(json!({"op":"mouse","action":"move","x":x,"y":1000.0}));
+        h.value(json!({"op":"mouse","action":"up","x":x,"y":1000.0}));
+        assert_eq!(h.rt.views[&1].ui.scroll[&3], g.max_top, "drag clamps beyond viewport");
+    }
+}
