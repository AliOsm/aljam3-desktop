+//! Short visual transitions run beside painting, independently of Ruby's event
+//! loop. A late frame samples elapsed time once; it never replays missed steps.
+
+use super::Runtime;
+use crate::props::Id;
+use crate::protocol::Outgoing;
+use serde_json::{Map, Value};
+use std::collections::BTreeMap;
+use std::time::Instant;
+
+pub const PROPERTIES: &[&str] = &["opacity", "displace_left", "displace_top", "hover_amount", "switch_position", "fraction"];
+
+struct Transition {
+    id: Id,
+    app: Id,
+    from: Map<String, Value>,
+    to: Map<String, Value>,
+    duration: f64,
+    started: Option<f64>,
+}
+
+pub struct Motion {
+    origin: Instant,
+    frozen: Option<f64>,
+    jobs: BTreeMap<u64, Transition>,
+    completed: Vec<(Id, Outgoing)>,
+}
+
+impl Default for Motion {
+    fn default() -> Self {
+        Self { origin: Instant::now(), frozen: None, jobs: BTreeMap::new(), completed: Vec::new() }
+    }
+}
+
+impl Motion {
+    fn now(&self) -> f64 { self.frozen.unwrap_or_else(|| self.origin.elapsed().as_secs_f64()) }
+
+    pub fn running(&self, app: Option<Id>) -> bool {
+        self.frozen.is_none() && (self.jobs.values().any(|job| app.is_none_or(|app| job.app == app)) ||
+            self.completed.iter().any(|(id, _)| app.is_none_or(|app| *id == app)))
+    }
+
+    pub fn cancel(&mut self, token: u64) {
+        self.jobs.remove(&token);
+        self.completed.retain(|(_, event)| !matches!(event, Outgoing::TransitionEnd { token: id, .. } if *id == token));
+    }
+
+    pub fn forget(&mut self, ids: &[Id]) {
+        self.jobs.retain(|_, job| !ids.contains(&job.id) && !ids.contains(&job.app));
+        self.completed.retain(|(app, event)| !ids.contains(app) && !matches!(event, Outgoing::TransitionEnd { id, .. } if ids.contains(id)));
+    }
+
+    pub fn presented(&mut self, app: Id) -> Vec<Outgoing> {
+        let (ready, pending): (Vec<_>, Vec<_>) = self.completed.drain(..).partition(|(id, _)| *id == app);
+        self.completed = pending;
+        ready.into_iter().map(|(_, event)| event).collect()
+    }
+}
+
+impl Runtime {
+    pub fn start_transition(&mut self, id: Id, token: u64, duration: f64, to: Map<String, Value>) {
+        let Some(node) = self.doc.get(id) else { return };
+        let Some(app) = self.doc.app_of(id) else { return };
+        if !duration.is_finite() || duration < 0.0 || to.is_empty() ||
+            !to.iter().all(|(key, value)| PROPERTIES.contains(&key.as_str()) && value.as_f64().is_some_and(f64::is_finite)) {
+            self.out.send(Outgoing::Log { level: "warn".into(), msg: "Invalid visual transition".into() });
+            return;
+        }
+        let from: Map<String, Value> = to.iter().map(|(key, value)| {
+            let value = node.props.0.get(key).filter(|v| v.is_number()).unwrap_or(value).clone();
+            (key.clone(), value)
+        }).collect();
+        // Reversals start at the last displayed values, not a destination or an
+        // extrapolated value that never reached the screen.
+        self.motion.jobs.retain(|_, job| job.id != id || !job.to.keys().any(|key| to.contains_key(key)));
+        if duration == 0.0 || from.iter().all(|(key, value)| value.as_f64() == to[key].as_f64()) {
+            self.set_props(id, to.clone());
+            self.out.send(Outgoing::TransitionEnd { token, id, props: to });
+            return;
+        }
+        let started = self.motion.frozen;
+        self.motion.jobs.insert(token, Transition { id, app, from, to, duration: duration.min(60.0), started });
+        if let Some(view) = self.views.get_mut(&app) { view.dirty = true; }
+    }
+
+    pub fn set_motion_clock(&mut self, at: Option<f64>) {
+        let before = self.motion.now();
+        let was_frozen = self.motion.frozen.is_some();
+        self.motion.frozen = at;
+        let after = self.motion.now();
