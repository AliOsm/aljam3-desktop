+//! Desktop accessibility preferences, without shell commands or console processes.
+
+#[cfg(target_os = "windows")]
+pub fn reduced_motion() -> bool {
+    #[link(name = "user32")]
+    unsafe extern "system" {
+        fn SystemParametersInfoW(action: u32, param: u32, value: *mut std::ffi::c_void, flags: u32) -> i32;
+    }
+    let mut animations: i32 = 1;
+    // SPI_GETCLIENTAREAANIMATION writes a BOOL to an initialized, writable pointer.
+    unsafe { SystemParametersInfoW(0x1042, 0, (&mut animations as *mut i32).cast(), 0); }
+    animations == 0
+}
