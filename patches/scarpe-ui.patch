+//! Temporary raster surfaces for fading groups. Content, layout, focus, typing,
+//! scrolling and image changes invalidate the surface; opacity alone does not.
+
+use super::{damage, Scene};
+use crate::doc::Doc;
+use crate::elements::image;
+use crate::layout::{Layout, Rect};
+use crate::props::Id;
+use cosmic_text::Buffer;
+use std::collections::{hash_map::DefaultHasher, HashMap, HashSet};
+use std::hash::{Hash, Hasher};
+use std::rc::Rc;
+use tiny_skia::Pixmap;
+
+const MAX_BYTES: usize = 128 * 1024 * 1024;
+
+#[derive(Default)]
+pub struct LayerCache {
+    entries: HashMap<Id, Layer>,
+    bytes: usize,
+    built: u64,
+    reused: u64,
+}
+
+pub struct Layer {
+    pub pixels: Pixmap,
+    pub signature: Signature,
+}
+
+pub struct Signature {
+    hash: u64,
+    // Retain the allocations whose identities the fingerprint uses.
+    _texts: Vec<Rc<Buffer>>,
+    _images: Vec<Rc<Pixmap>>,
+}
+
+impl LayerCache {
+    pub fn len(&self) -> usize { self.entries.len() }
+
+    pub fn retain(&mut self, doc: &Doc, layout: &Layout) {
+        self.entries.retain(|id, _| layout.boxes.contains_key(id) && doc.get(*id).is_some_and(|node|
+            node.props.f32("opacity").is_some_and(|o| o > 0.0 && o < 1.0)));
+        self.bytes = self.entries.values().map(|layer| layer.pixels.data().len()).sum();
+    }
+
+    pub fn take(&mut self, id: Id, signature: &Signature) -> Option<Layer> {
+        let entry = self.entries.remove(&id)?;
+        self.bytes -= entry.pixels.data().len();
+        if entry.signature.hash != signature.hash { return None; }
+        self.reused += 1;
+        Some(entry)
+    }
+
+    pub fn built(&mut self) { self.built += 1; }
+
+    pub fn put(&mut self, id: Id, layer: Layer) {
+        let bytes = layer.pixels.data().len();
+        if bytes > MAX_BYTES { return; }
+        if self.bytes + bytes > MAX_BYTES {
+            self.entries.clear();
+            self.bytes = 0;
+        }
+        self.bytes += bytes;
+        self.entries.insert(id, layer);
+    }
+
+    pub fn take_counts(&mut self) -> (u64, u64) {
+        (std::mem::take(&mut self.built), std::mem::take(&mut self.reused))
+    }
+}
+
+pub fn signature(scene: &mut Scene, ids: &[Id], scale: f32, region: (i32, i32, i32, i32), only: Option<Rect>) -> Signature {
+    let mut hash = DefaultHasher::new();
+    let mut texts = Vec::new();
+    let mut images = Vec::new();
+    let hovered: HashSet<_> = scene.view.hover_chain.iter().copied().collect();
+    scale.to_bits().hash(&mut hash);
+    region.hash(&mut hash);
+    only.map(|r| [r.x.to_bits(), r.y.to_bits(), r.w.to_bits(), r.h.to_bits()]).hash(&mut hash);
+    ids.hash(&mut hash);
+    for id in ids {
+        let (Some(node), Some(lbox)) = (scene.doc.get(*id), scene.layout.boxes.get(id)) else { continue };
+        for (key, value) in &node.props.0 {
+            if *id == ids[0] && key == "opacity" { continue; }
+            key.hash(&mut hash);
+            value.hash(&mut hash);
+        }
+        let text = scene.layout.texts.get(id);
+        damage::fingerprint(node, lbox, text, scene.view, &hovered).hash(&mut hash);
+        if let Some(text) = text {
+            Rc::as_ptr(&text.shaped.buffer).hash(&mut hash);
+            texts.push(text.shaped.buffer.clone());
+        }
+        if let Some(scroller) = scene.layout.scrollers.get(id) {
+            scroller.top.to_bits().hash(&mut hash);
+            scroller.content_height.to_bits().hash(&mut hash);
+        }
+        for path in image::shown_by(node) {
+            let image = scene.images.get(&path);
+            image.as_ref().map(Rc::as_ptr).hash(&mut hash);
+            images.extend(image);
+        }
+    }
+    Signature { hash: hash.finish(), _texts: texts, _images: images }
+}
+
+/// Integer-position, unfiltered source-over for an already rasterized surface.
+/// Blend premultiplied RGBA8 directly, without shader dispatch, coordinate
+/// transforms or sampling. Keep opacity at 16-bit precision and round only the
+/// final channel. Quantization differs by at most one byte from the floating-
+/// point rasterizer; opaque endpoints and clipping are exact.
+pub fn blend(destination: &mut Pixmap, source: &Pixmap, x: i32, y: i32, opacity: f32) {
+    let left = x.max(0).min(destination.width() as i32);
+    let top = y.max(0).min(destination.height() as i32);
+    let right = (x + source.width() as i32).max(0).min(destination.width() as i32);
+    let bottom = (y + source.height() as i32).max(0).min(destination.height() as i32);
+    if right <= left || bottom <= top { return; }
+    let source_left = (left - x) as usize * 4;
+    let destination_left = left as usize * 4;
+    let bytes = (right - left) as usize * 4;
+    let coverage = (opacity.clamp(0.0, 1.0) * 65_536.0 + 0.5) as u32;
+    let destination_stride = destination.width() as usize * 4;
+    let source_rows = source.data().chunks_exact(source.width() as usize * 4).skip((top - y) as usize);
+    let destination_rows = destination.data_mut().chunks_exact_mut(destination_stride).skip(top as usize);
+    const DENOMINATOR: u32 = 255 * 65_536;
+    let source_weight = coverage * 255;
+    for (src, dst) in source_rows.zip(destination_rows).take((bottom - top) as usize) {
+        let src = &src[source_left..source_left + bytes];
+        let dst = &mut dst[destination_left..destination_left + bytes];
+        // Whole opaque rows can interpolate their channels in one branch-free
+        // loop. This is the common case for a page, including its PDF image.
+        if src.chunks_exact(4).all(|pixel| pixel[3] == 255) {
+            blend_opaque(dst, src, coverage);
+            continue;
+        }
+        let src = src.chunks_exact(4);
+        let dst = dst.chunks_exact_mut(4);
+        for (src, dst) in src.zip(dst) {
+            if src[3] == 0 { continue; }
+            if src[3] == 255 {
+                blend_opaque(dst, src, coverage);
+                continue;
+            }
+            let inverse = DENOMINATOR - src[3] as u32 * coverage;
+            for (source, destination) in src.iter().zip(dst) {
+                // Premultiplication bounds this sum below 2^32, even for white.
+                let numerator = *source as u32 * source_weight + *destination as u32 * inverse + DENOMINATOR / 2;
+                let rounded = numerator / DENOMINATOR;
+                let tie = numerator == rounded * DENOMINATOR;
+                *destination = (rounded - u32::from(tie && rounded & 1 != 0)) as u8;
+            }
+        }
+    }
+}
+
+fn blend_opaque(destination: &mut [u8], source: &[u8], coverage: u32) {
+    for (source, destination) in source.iter().zip(destination) {
+        let difference = *source as i32 - *destination as i32;
+        *destination = (*destination as i32 + ((difference * coverage as i32 + 32_768) >> 16)) as u8;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tiny_skia::{Color, PixmapPaint, Transform};
+
+    #[test]
+    fn rgba8_blending_has_bounded_quantization_and_correct_clipping() {
+        let mut source = Pixmap::new(81, 67).unwrap();
+        let mut destination = Pixmap::new(110, 93).unwrap();
+        for (i, pixel) in source.pixels_mut().iter_mut().chain(destination.pixels_mut()).enumerate() {
+            *pixel = Color::from_rgba8(i as u8, (i * 17) as u8, (i * 33) as u8, (i * 7) as u8).premultiply().to_color_u8();
+        }
+        for opacity in [0.0, 0.001, 0.13, 0.5, 0.91, 0.999, 1.0] {
+            for (x, y) in [(0, 0), (13, 21), (-7, -11), (104, 90), (500, 500), (-500, -500)] {
+                let mut expected = destination.clone();
+                let mut actual = destination.clone();
+                expected.draw_pixmap(x, y, source.as_ref(), &PixmapPaint { opacity, ..PixmapPaint::default() }, Transform::identity(), None);
+                blend(&mut actual, &source, x, y, opacity);
+                for (actual, expected) in actual.data().iter().zip(expected.data()) {
+                    assert!(actual.abs_diff(*expected) <= 1, "opacity {opacity}, offset {x},{y}: {actual} != {expected}");
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn every_opacity_keeps_channels_premultiplied_and_matches_the_reference() {
+        for opaque in [false, true] {
+            let mut source = Pixmap::new(257, 16).unwrap();
+            let mut destination = source.clone();
+            for (i, pixel) in source.pixels_mut().iter_mut().chain(destination.pixels_mut()).enumerate() {
+                let alpha = if opaque { 255 } else { (i * 7) as u8 };
+                *pixel = Color::from_rgba8(i as u8, (i * 17) as u8, (i * 33) as u8, alpha).premultiply().to_color_u8();
+            }
+            for alpha in 0..=255u32 {
+                let mut actual = destination.clone();
+                let mut expected = destination.clone();
+                let opacity = alpha as f32 / 255.0;
+                blend(&mut actual, &source, 0, 0, opacity);
+                expected.draw_pixmap(0, 0, source.as_ref(), &PixmapPaint { opacity, ..PixmapPaint::default() }, Transform::identity(), None);
+                for (got, expected) in actual.data().chunks_exact(4).zip(expected.data().chunks_exact(4)) {
+                    for channel in 0..4 {
+                        assert!(got[channel] <= got[3]);
+                        assert!(got[channel].abs_diff(expected[channel]) <= 1);
+                    }
+                }
+            }
+        }
+    }
+}
